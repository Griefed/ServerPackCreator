{
  "name": "serverpackcreator-web-frontend",
  "version": "2.1.1",
  "description": "Frontend for the webservice of ServerPackCreator",
  "productName": "ServerPackCreator",
  "author": "Griefed <griefed@griefed.de>",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{ts,js,vue,html,md,json}\" --ignore-path .gitignore",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "quasar clean",
    "dev": "quasar dev",
    "build": "quasar build",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.0",
    "axios": "^1.16.0",
    "pinia": "^3.0.4",
    "quasar": "^2.19.3",
    "vue": "^3.5.27",
    "vue-i18n": "^11.1.12",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@intlify/unplugin-vue-i18n": "11.2.5",
    "@pinia/testing": "1.0.3",
    "@quasar/app-vite": "3.10.2",
    "@quasar/vite-plugin": "2.0.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/test-utils": "2.5.1",
    "autoprefixer": "10.6.1",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "16.5.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.1",
    "vite-plugin-checker": "0.14.5",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.13"
  },
  "engines": {
    "node": ">= 24",
    "npm": ">= 11",
    "yarn": ">= 4"
  }
}
