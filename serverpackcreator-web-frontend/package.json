{
  "name": "serverpackcreator-web-frontend",
  "version": "2.1.0",
  "description": "Frontend for the webservice of ServerPackCreator",
  "productName": "ServerPackCreator",
  "author": "Griefed <griefed@griefed.de>",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.4.2",
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,vue,html,md,json}\" --ignore-path .gitignore",
    "test": "vitest run",
    "clean": "quasar clean",
    "dev": "quasar dev",
    "build": "quasar build",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.0",
    "axios": "^1.16.0",
    "pinia": "^3.0.4",
    "quasar": "^2.19.3",
    "vue": "^3.5.27",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@intlify/unplugin-vue-i18n": "^11.2.3",
    "@pinia/testing": "^1.0.3",
    "@quasar/app-vite": "^2.4.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.8.3",
    "vite-plugin-checker": "^0.14.1",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">= 22",
    "npm": ">= 10",
    "yarn": ">= 4"
  }
}
