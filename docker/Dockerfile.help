FROM ghcr.io/linuxserver/nginx:1.30.4@sha256:18589f85a30440a4d4ebcd2967c948013bd0a02e9021c7df2378edff4d0a07aa

ARG VERSION=dev
ENV ARTIFACT=webHelpSPCH2-all.zip

LABEL maintainer="Griefed <griefed@griefed.de>"

COPY public/$ARTIFACT /tmp/$ARTIFACT

RUN \
  apk --update add unzip && \
  rm -rf \
    /config/www/* && \
  unzip -d /config/www/ /tmp/$ARTIFACT && \
  echo "**** Cleanup ****" && \
  apk del unzip && \
  rm -rf \
    /var/cache/apk/* \
    /root/.cache \
    /tmp/*

# The Kotlin API reference (Dokka HTML for `serverpackcreator-api`), merged in here because Writerside cannot
# host a generated file tree itself -- see the comment in `Writerside/spch.tree`. This is the path a reader
# reaches by URL; the help site's own TOC entry is an absolute link to the published copy, because the
# Writerside viewer will not navigate to a relative one.
#
# AFTER the RUN above, never before: that RUN opens with `rm -rf /config/www/*`, which would delete this.
# The source is NOT optional -- a missing `public/api/` fails the build here rather than silently shipping a
# help site whose "Kotlin API (Dokka)" entry 404s. `.forgejo/workflows/docs.yml` populates it from the `dokka`
# job's artifact; `.github/workflows/pages.yml` builds the same layout for GitHub Pages.
COPY public/api/ /config/www/api/

EXPOSE 80 443
