# Enables the `app` profile, which docker-compose-dev.yml keeps the ServerPackCreator service behind.
#
# This exists for the `Dev stack (with app)` run configuration in `.run/`: IntelliJ's Docker Compose
# configuration takes an env file, and Compose reads COMPOSE_PROFILES from it exactly as it would
# from the environment. From a terminal use the documented flag instead -- `--profile app` -- rather
# than passing this file; BUILD.md gives that command.
#
# Do NOT move this into `docker/.env`. Compose picks that up automatically, which would opt the
# plain `docker compose -f docker/docker-compose-dev.yml up -d` into building the application image
# too, and that is the fast path this stack exists to keep fast.
COMPOSE_PROFILES=app
